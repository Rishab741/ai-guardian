# Presenter features: seeded history, demo reset, persona switcher (Phase 2).
DEMO_MODE=true
ENVIRONMENT=local

# Local: docker compose -f deploy/compose/docker-compose.dev.yml up -d
DATABASE_URL=postgresql://sf:sf_dev_password@localhost:5433/sovereignfabric

# gemini = real calls; simulated = offline canned answers.
LLM_PROVIDER=gemini
# Create this key in a Google Cloud project WITHOUT billing so it stays on the
# free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_BALANCED_MODEL=gemini-3.6-flash
GEMINI_DEEP_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Pins the "Advisor Assist" demo app's key (format: sf-live-<random>).
# Leave empty to generate one at first start (printed once in the log).
SF_DEMO_APP_KEY=

CORS_ORIGINS=http://localhost:3000
