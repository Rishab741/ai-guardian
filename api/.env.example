DEMO_MODE=true

# --- Production mode only (DEMO_MODE=false) ---
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=...
GEMINI_FAST_MODEL=gemini-2.0-flash
GEMINI_DEEP_MODEL=gemini-2.5-pro
GEMINI_EMBED_MODEL=text-embedding-004

# From your Supabase project's Settings -> API. Only the Project URL is
# needed here — no JWT secret (auth tokens are verified via Supabase's JWT
# Signing Keys / JWKS, fetched automatically from this URL, see auth.py) and
# no service_role key (this backend talks to Postgres directly, never via
# Supabase's REST/Admin API).
SUPABASE_URL=https://xxxx.supabase.co

# Supabase's "connection pooling" URI (Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# --- Shared ---
CORS_ORIGINS=http://localhost:3000
