# The gateway's base URL (the console calls its /api/* routes).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Advisor Assist mock app (server-side only, never sent to the browser).
# Gateway it calls, and the "Advisor Assist" app key (SF_DEMO_APP_KEY on the gateway).
GATEWAY_URL=http://localhost:8000
ADVISOR_GATEWAY_KEY=
# Optional: a Gemini key for the "before" (direct) mode. Without it, direct
# mode only shows what would be sent. Synthetic data only.
ADVISOR_DIRECT_API_KEY=
